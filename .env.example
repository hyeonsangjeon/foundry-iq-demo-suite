# Example environment variables (do NOT put real secrets here)
# Copy to .env.local or .env and fill in your real values which must never be committed.

# ==========================================
# VERCEL DEPLOYMENT CONFIGURATION
# ==========================================
# For Vercel deployment, add these environment variables in your Vercel project settings:
# https://vercel.com/[your-team]/[your-project]/settings/environment-variables
#
# REQUIRED STEPS:
# 1. Create Service Principal:
#    az ad sp create-for-rbac --name "vercel-ai-agent-demo" --role "Cognitive Services User" --scopes /subscriptions/YOUR_SUBSCRIPTION_ID/resourceGroups/YOUR_RESOURCE_GROUP
# 2. Copy the output values (appId, password, tenant) to Vercel environment variables
# 3. Add all variables below to Vercel (do NOT prefix with NEXT_PUBLIC_ unless specified)
# ==========================================

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://your-search-resource.search.windows.net
AZURE_SEARCH_API_KEY=your-azure-search-admin-or-query-key
AZURE_SEARCH_API_VERSION=2025-11-01-preview

# Microsoft Learn MCP Knowledge Source demo (optional overrides)
# MCP Server Knowledge Sources require the 2026-05-01-preview API.
MCP_KS_API_VERSION=2026-05-01-preview
MCP_KS_KNOWLEDGE_BASE_NAME=your-microsoft-learn-knowledge-base
MCP_KS_KNOWLEDGE_SOURCE_NAME=your-microsoft-learn-mcp-knowledge-source

# Microsoft Web IQ public-web search (optional, server-side only)
# Default api-key; set entra to reuse the service principal configured below.
WEBIQ_AUTH_METHOD=api-key
# In api-key mode, obtain a key for your Web IQ AppID; leave empty to disable live search.
# https://learn.microsoft.com/en-us/web-iq/get-started/quickstart
WEBIQ_API_KEY=
# Entra requires AZURE_AUTH_METHOD=service-principal and all three AZURE_* credentials.
# Bind that Application (client) ID to your Web IQ AppID in https://webiq.microsoft.ai/profiles/.
# Optional Web IQ AppID selector for Entra; required when the client ID has multiple AppIDs.
# Ignored in api-key mode, where the key already selects the AppID.
WEBIQ_APP_ID=
# Existing Azure OpenAI chat deployment used to combine KB and Web IQ evidence.
# Uses AZURE_OPENAI_ENDPOINT or NEXT_PUBLIC_AZURE_OPENAI_ENDPOINT and API key or Entra auth.
WEBIQ_ANSWER_DEPLOYMENT=
# Verify the deployment's actual model/version/SKU before setting this price profile.
# Supported: gpt-4o 2024-11-20 GlobalStandard (budget uses 20% above USD retail).
# Re-verify pricing before changing deployments. Unknown profiles stop paid synthesis.
WEBIQ_ANSWER_PRICING_MODEL=

# Bot verification for every paid Web IQ search and combined answer.
# Create a Managed Turnstile widget for the exact deployment hostname.
# Site key is public; the secret stays server-only. No test keys in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=foundry-iq-demo-suite.vercel.app

# Web IQ usage only: $5 per Asia/Seoul calendar day, 100/IP/rolling 120s.
# Includes Web IQ search and its additional answer synthesis; existing KB calls are excluded.
# With network-restricted storage, use the Azure Container Apps usage broker.
# Its managed identity has Blob Data Contributor on the usage container only.
# These settings are server-only. Never add NEXT_PUBLIC_ or send them to a browser.
# HTTPS origin only, without a trailing path. Requests fail closed if the broker is unavailable.
DEMO_USAGE_BROKER_URL=
DEMO_USAGE_BROKER_SECRET=
# Broker configuration (or direct Blob access where the network permits it).
# A private Azure Blob, shared by every production instance; never use a SAS URL.
# Missing/unavailable configuration stops paid demo calls (no in-memory fallback).
DEMO_USAGE_BLOB_URL=https://your-storage.blob.core.windows.net/demo-usage/ledger.json
# Generate a random server-only secret (at least 32 characters); never expose in NEXT_PUBLIC_.
DEMO_USAGE_HASH_SECRET=
# LOCAL LOOPBACK SERVERS ONLY. Omit in deployments; Vercel uses its trusted IP header.
DEMO_USAGE_LOCAL_ONLY=false

# Azure OpenAI
NEXT_PUBLIC_AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key

# Standalone Azure OpenAI (Higher Rate Limits)
NEXT_PUBLIC_STANDALONE_AOAI_ENDPOINT=https://your-standalone-openai.openai.azure.com
NEXT_PUBLIC_STANDALONE_AOAI_KEY=your-standalone-openai-key

# Foundry Project Configuration
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_API_VERSION=2025-05-01

# ==========================================
# AUTHENTICATION - Service Principal (REQUIRED FOR VERCEL)
# ==========================================
# Use Service Principal for automatic bearer token refresh on Vercel
AZURE_AUTH_METHOD=service-principal
AZURE_TENANT_ID=your-tenant-id-from-service-principal-output
AZURE_CLIENT_ID=your-app-id-from-service-principal-output
AZURE_CLIENT_SECRET=your-password-from-service-principal-output

# ==========================================
# ALTERNATIVE: Manual Bearer Token (NOT RECOMMENDED for Vercel)
# ==========================================
# Only use this for local testing - tokens expire in ~1 hour
# Generate with: az account get-access-token --resource https://ai.azure.com --query accessToken -o tsv
# FOUNDRY_BEARER_TOKEN=your-bearer-token-from-azure-cli

# ==========================================
# ALTERNATIVE: Managed Identity (NOT AVAILABLE on Vercel)
# ==========================================
# Only works on Azure App Service/Container Apps
# AZURE_AUTH_METHOD=managed-identity
# AZURE_MANAGED_IDENTITY_CLIENT_ID=optional-client-id-if-using-user-assigned-identity

# Public Search Endpoint (for MCP URLs)
NEXT_PUBLIC_SEARCH_ENDPOINT=https://your-search-resource.search.windows.net

# Azure Blob Storage (image proxy SAS token — server-side only, do NOT use NEXT_PUBLIC_)
# Generate at: Azure Portal → stfoundryiqdemo2 → Shared access signature → Blob read-only
AZURE_BLOB_SAS_TOKEN=?sv=2022-11-02&ss=b&srt=co&sp=r&se=2027-01-01T00:00:00Z&spr=https&sig=your-sas-signature

# Other (add as needed)
# NEXT_PUBLIC_ANALYTICS_ID=

# Browse stays disabled until the additive broker update and bounded preview checks.
WEBIQ_BROWSE_ENABLED=false
# Server-only HMAC key, at least 32 characters; never use a public env prefix.
WEBIQ_SOURCE_TICKET_SECRET=
# Optional exact public HTTPS hosts (comma-separated); no arbitrary client URL input.
WEBIQ_BROWSE_ALLOWED_HOSTS=
# Auto is gated off; AppID access, pricing and weather schema remain unverified.
WEBIQ_AUTO_ENABLED=false
